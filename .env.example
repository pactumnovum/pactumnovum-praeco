# Copy to .env for local runs. .env is never committed.
# With DRY_RUN=1 nothing below is needed: fixtures, the model stub and a local database are used.
DRY_RUN=1

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

ZERNIO_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Kill switch. Anything but exactly "true" means dry run.
PUBLISHING_ENABLED=
# Hard stop for model spend. Unset or 0 means no paid model calls.
MONTHLY_AI_BUDGET_USD=
